    old = '''function escapeHtml(s) {
  return String(s ?? "").replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
}'''
    new = '''function escapeHtml(s) {
  return String(s ?? "").replace(/[&<>"'`]/g, c => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;",
    '"': "&quot;", "'": "&#39;", "`": "&#96;"
  }[c]));
}'''
    c, _ = replace_once(c, old, new, "escapeHtml")

    # ─────────────────────────────────────────────
    # FIX #2: usePinLockout - functional updates
    # ─────────────────────────────────────────────
    print("\n[2] usePinLockout")
    old = '''function usePinLockout(max = 5, lockMs = 30000) {
  const [fails, setFails] = useState(0);
  const [lockedUntil, setLockedUntil] = useState(0);
  return {
    isLocked: () => Date.now() < lockedUntil,
    secondsLeft: () => Math.max(0, Math.ceil((lockedUntil - Date.now()) / 1000)),
    registerFail: () => {
      const n = fails + 1;
      if (n >= max) { setLockedUntil(Date.now() + lockMs); setFails(0); } else setFails(n);
    },
    reset: () => setFails(0)
  };
}'''
    new = '''function usePinLockout(max = 5, lockMs = 30000) {
  const [fails, setFails] = useState(0);
  const [lockedUntil, setLockedUntil] = useState(0);

  const isLocked = useCallback(() => Date.now() < lockedUntil, [lockedUntil]);
  const secondsLeft = useCallback(
    () => Math.max(0, Math.ceil((lockedUntil - Date.now()) / 1000)),
    [lockedUntil]
  );

  const registerFail = useCallback(() => {
    setFails(prev => {
      const n = prev + 1;
      if (n >= max) {
        setLockedUntil(Date.now() + lockMs);
        return 0;
      }
      return n;
    });
  }, [max, lockMs]);

  const reset = useCallback(() => setFails(0), []);

  return { isLocked, secondsLeft, registerFail, reset };
}'''
    c, _ = replace_once(c, old, new, "usePinLockout")

